<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.mt.rec">
  <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <application android:label="MT Recorder" android:debuggable="true">
    <activity android:name=".Main" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".Rec" android:exported="false" android:foregroundServiceType="microphone"/>
  </application>
</manifest>
